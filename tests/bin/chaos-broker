#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

COMPOSE=(docker compose)
SERVICE=rabbitmq

usage() {
  cat <<'EOF'
Inject docker compose RabbitMQ faults for the chaos PHPUnit suite.

Tests call this via Harness::broker() / brokerLater(). Do not use it to run
tests; use ./vendor/bin/phpunit --testsuite chaos (or composer chaos).

Usage:
  tests/bin/chaos-broker <command>

Commands:
  restart        Restart RabbitMQ and wait until it is healthy
  stop           Stop the container without removing it
  start          Start a stopped container and wait until healthy
  pause          Freeze the broker process (TCP stays up, no AMQP progress)
  unpause        Resume a paused broker
  memory-alarm   Force a memory alarm (connection.blocked)
  memory-ok      Restore the default memory watermark
  disk-alarm     Force a disk alarm (connection.blocked)
  disk-ok        Restore the default disk free space limit (50MB)
EOF
}

need_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "docker is required to inject chaos broker faults" >&2
    exit 1
  fi
}

wait_ready() {
  local timeout="${1:-60}"
  local started
  started="$(date +%s)"

  until "${COMPOSE[@]}" exec -T "$SERVICE" rabbitmq-diagnostics -q check_running >/dev/null 2>&1 \
     && "${COMPOSE[@]}" exec -T "$SERVICE" rabbitmq-diagnostics -q ping >/dev/null 2>&1; do
    if (( "$(date +%s)" - started >= timeout )); then
      echo "RabbitMQ did not become ready within ${timeout}s" >&2
      exit 1
    fi
    sleep 1
  done
}

wait_for_alarms() {
  local timeout="${1:-20}"
  local started
  started="$(date +%s)"

  # check_local_alarms exits 0 when there are no alarms.
  while "${COMPOSE[@]}" exec -T "$SERVICE" rabbitmq-diagnostics -q check_local_alarms >/dev/null 2>&1; do
    if (( "$(date +%s)" - started >= timeout )); then
      echo "RabbitMQ did not report a resource alarm within ${timeout}s" >&2
      exit 1
    fi
    sleep 0.25
  done
}

wait_for_no_alarms() {
  local timeout="${1:-20}"
  local started
  started="$(date +%s)"

  until "${COMPOSE[@]}" exec -T "$SERVICE" rabbitmq-diagnostics -q check_local_alarms >/dev/null 2>&1; do
    if (( "$(date +%s)" - started >= timeout )); then
      echo "RabbitMQ alarms did not clear within ${timeout}s" >&2
      exit 1
    fi
    sleep 0.25
  done
}

need_docker

cmd="${1:-}"
case "$cmd" in
  restart)
    "${COMPOSE[@]}" restart "$SERVICE"
    "${COMPOSE[@]}" up -d --wait
    wait_ready
    ;;
  stop)
    "${COMPOSE[@]}" stop "$SERVICE"
    ;;
  start)
    "${COMPOSE[@]}" start "$SERVICE"
    "${COMPOSE[@]}" up -d --wait
    wait_ready
    ;;
  pause)
    "${COMPOSE[@]}" pause "$SERVICE"
    ;;
  unpause)
    "${COMPOSE[@]}" unpause "$SERVICE"
    wait_ready 15
    ;;
  memory-alarm)
    wait_ready
    "${COMPOSE[@]}" exec -T "$SERVICE" rabbitmqctl set_vm_memory_high_watermark absolute 1
    ;;
  memory-ok)
    wait_ready
    "${COMPOSE[@]}" exec -T "$SERVICE" rabbitmqctl set_vm_memory_high_watermark 0.4
    ;;
  disk-alarm)
    wait_ready
    "${COMPOSE[@]}" exec -T "$SERVICE" rabbitmqctl set_disk_free_limit mem_relative 1000
    wait_for_alarms
    ;;
  disk-ok)
    wait_ready
    "${COMPOSE[@]}" exec -T "$SERVICE" rabbitmqctl set_disk_free_limit 50MB
    wait_for_no_alarms
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac

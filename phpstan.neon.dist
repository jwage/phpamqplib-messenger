parameters:
    level: max
    treatPhpDocTypesAsCertain: false
    # Some ignores only apply to certain Symfony versions in the CI matrix.
    reportUnmatchedIgnoredErrors: false
    paths:
        - config
        - src
        - tests
    tmpDir: var/phpstan
    excludePaths:
        # Generated by Symfony when the test kernel boots.
        - config/reference.php (?)
    ignoreErrors:
        # These assertions check interface and class contracts at runtime even though
        # PHPStan can already infer the result.
        -
            identifier: function.alreadyNarrowedType
            paths:
                - tests
        -
            identifier: staticMethod.alreadyNarrowedType
            paths:
                - tests
        # Symfony version compatibility checks: method_exists() is true or false depending
        # on the installed Symfony.
        -
            identifier: function.impossibleType
            paths:
                - tests/Unit/EventListener/AmqpWorkerListenerTest.php
                - tests/E2e/E2eConsumeEventSubscriber.php
        # These tests intentionally pass invalid values or call undeclared methods.
        -
            identifier: argument.type
            paths:
                - tests/Unit/Transport/Config/BindingConfigTest.php
                - tests/Unit/Transport/Config/ExchangeConfigTest.php
                - tests/Unit/Transport/Config/SslConfigTest.php
        -
            identifier: method.notFound
            paths:
                - tests/Unit/BatchTest.php
        -
            identifier: phpunit.mockMethod
            paths:
                - tests/Unit/BatchTest.php
        # KeepaliveReceiverInterface only exists in Symfony 7.2+.
        -
            identifier: class.notFound
            paths:
                - tests/Unit/Transport/AmqpKeepaliveReceiverInterfaceTest.php
